# OneAtlas AI Generation Pipeline - Environment Variables

# ===========================================
# AI Provider API Keys
# ===========================================
# The gateway supports all 8 providers as configurable options.
# You must provide at least 3 of these to run the pipeline.

OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GROQ_API_KEY=""
GEMINI_API_KEY=""
GOOGLE_AI_API_KEY=""
DEEPSEEK_API_KEY=""
OPENROUTER_API_KEY=""
MISTRAL_API_KEY=""

# ===========================================
# Server Configuration
# ===========================================
PORT=3001
FRONTEND_URL=http://localhost:3000

# ===========================================
# Pipeline Configuration
# ===========================================
GEMINI_MODEL=gemini-2.0-flash
OPENROUTER_MODEL=openrouter/auto
MAX_REPAIR_ATTEMPTS=2
